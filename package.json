{
  "name": "liftwise",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "vp check --fix",
    "ci:check": "vp check && vp run -r typecheck && vp test",
    "ci:build": "vp run -r build",
    "deploy:api": "pnpm --filter @liftwise/api run deploy",
    "android:build": "pnpm --filter @liftwise/web android:build",
    "android:install": "pnpm --filter @liftwise/web android:install",
    "e2e": "pnpm --filter @liftwise/e2e test",
    "eval": "pnpm --filter @liftwise/evals eval"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@10.18.1"
}
